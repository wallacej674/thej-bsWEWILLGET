ENVIRONMENT=development
APP_NAME=ApplyTogether API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://applytogether:applytogether@127.0.0.1:5434/applytogether
# Production: DATABASE_URL uses the DML-only app role and MIGRATION_DATABASE_URL
# the schema-owning migrator (see `python -m app.commands.create_db_roles`), both
# with ?sslmode=verify-full.
# MIGRATION_DATABASE_URL=
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
DEV_IDENTITY_HEADER_ENABLED=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Host names the API answers to. In production list only your API domain(s).
ALLOWED_HOSTS=["localhost","127.0.0.1"]
AUTH_JWT_SECRET_KEY=generate-a-long-random-secret-and-keep-it-out-of-git
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=20
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Sign-in throttling (see docs/security/SECURITY_AUDIT.md, SEC-03).
LOGIN_THROTTLE_SOURCE_FAILURES=5
LOGIN_THROTTLE_ACCOUNT_FAILURES=20
LOGIN_THROTTLE_WINDOW_MINUTES=15
LOGIN_THROTTLE_BASE_LOCK_SECONDS=60
LOGIN_THROTTLE_MAX_LOCK_MINUTES=60
LOGIN_DEVICE_COOKIE_DAYS=365
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-google-account@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-google-account@gmail.com
SMTP_FROM_NAME=ApplyTogether
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_HOURS=24
EMAIL_RESEND_COOLDOWN_SECONDS=60
OPENAI_API_KEY=
OPENAI_RESUME_TAILOR_MODEL=gpt-5.4-nano
OPENAI_RESUME_TAILOR_MAX_INPUT_TOKENS=30000
OPENAI_RESUME_TAILOR_MAX_OUTPUT_TOKENS=1800
OPENAI_RESUME_TAILOR_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
APP_TIMEZONE=America/Chicago
# Hard cap on active members per workspace, enforced on invite and accept.
WORKSPACE_MEMBER_CAP=500
SEED_JONATHAN_EMAIL=jonathan@example.test
SEED_JONATHAN_DISPLAY_NAME=Jonathan
SEED_KAREEM_EMAIL=kareem@example.test
SEED_KAREEM_DISPLAY_NAME=Kareem
